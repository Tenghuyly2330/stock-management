# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# PostgreSQL Connection String (Replace with your local or cloud DB URL)
# Example local: postgresql://postgres:postgres@localhost:5432/stock_db
# Example Neon: postgresql://<user>:<password>@<neon-host>/<database>?sslmode=require
DB_URL=postgresql://postgres:postgres@localhost:5432/stock_management

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here
JWT_EXPIRES_IN=24h
