# ==============================================================================
# Kubernetes Secret Template (Example Only)
# In production, create this directly using sealed-secrets, Vault, or kubectl:
# kubectl create secret generic stock-backend-secrets \
#   --namespace stock-system \
#   --from-literal=DB_URL='postgresql://postgres:password@postgres-service:5432/stock_management' \
#   --from-literal=JWT_SECRET='your-secure-32-char-jwt-secret' \
#   --from-literal=CLOUDINARY_CLOUD_NAME='your-cloud' \
#   --from-literal=CLOUDINARY_API_KEY='your-key' \
#   --from-literal=CLOUDINARY_API_SECRET='your-secret'
# ==============================================================================
apiVersion: v1
kind: Secret
metadata:
  name: stock-backend-secrets
  namespace: stock-system
type: Opaque
stringData:
  DB_URL: "postgresql://postgres:REPLACE_WITH_STRONG_PASSWORD@postgres-service:5432/stock_management"
  JWT_SECRET: "REPLACE_WITH_A_SECURE_MIN_32_CHAR_JWT_SECRET_KEY"
  CLOUDINARY_CLOUD_NAME: "REPLACE_WITH_CLOUDINARY_CLOUD_NAME"
  CLOUDINARY_API_KEY: "REPLACE_WITH_CLOUDINARY_API_KEY"
  CLOUDINARY_API_SECRET: "REPLACE_WITH_CLOUDINARY_API_SECRET"
  POSTGRES_PASSWORD: "REPLACE_WITH_STRONG_PASSWORD"
